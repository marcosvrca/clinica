# App
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (usa o mesmo Docker do bot na porta 5433)
DATABASE_URL=postgresql://bot:bot_secret@localhost:5433/clinica?schema=public

# Segurança da API
# Bot WhatsApp envia x-api-key (somente server-side — nunca no front)
# Em production: troque TODOS os valores *-change-me-* (a API recusa subir com exemplos)
CLINIC_API_KEY=clinic-api-key-change-me-16
# Clínica vinculada à API key (OBRIGATÓRIO em production)
CLINIC_ID=
# JWT do painel web (mín. 32 caracteres)
JWT_SECRET=clinic-jwt-secret-change-me-32chars
# AES-GCM dos campos clínicos (mín. 32 caracteres) — não reutilize JWT_SECRET em produção
CLINICAL_ENCRYPTION_KEY=clinic-clinical-key-change-me-32
# Origens permitidas no CORS (separadas por vírgula). Use * só em dev; em production liste HTTPS (ou same-origin).
CORS_ORIGINS=http://localhost:5173

# Fuso e regras
TIMEZONE=America/Sao_Paulo
CANCEL_MIN_HOURS=2
SLOT_INTERVAL_MINUTES=50
REMINDER_HOURS_BEFORE=24

# Lembretes / cobranças automáticas
REMINDER_WHATSAPP_ENABLED=true
REMINDER_EMAIL_ENABLED=true
# Resend (https://resend.com) — deixe vazio para só WhatsApp
RESEND_API_KEY=
RESEND_FROM=Clínica Bem Estar <onboarding@resend.dev>
# Links Confirmar / Remarcar (API pública) — em production use HTTPS público
PUBLIC_BASE_URL=http://localhost:4000
# Painel web (em produção no Railway = mesma URL pública do serviço)
WEB_BASE_URL=http://localhost:5173

# Pagamentos online
# auto = sandbox só fora de production; true/false força
PAYMENTS_ALLOW_SANDBOX=auto
# Header x-clinic-webhook-secret OU ?secret= na URL de notificação — obrigatório em production
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_DEFAULT_PROVIDER=mercado_pago
MERCADOPAGO_ACCESS_TOKEN=
# Id do plano Assinaturas MP (legado / fallback Individual). Preferir *_SOLO / *_TEAM.
MERCADOPAGO_PREAPPROVAL_PLAN_ID=
MERCADOPAGO_PREAPPROVAL_PLAN_ID_SOLO=
MERCADOPAGO_PREAPPROVAL_PLAN_ID_TEAM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
# Produção Asaas: https://api.asaas.com/api/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Assinatura do painel (onboarding SaaS)
# Individual R$ 39,90 (1 profissional) / Compartilhado R$ 69,90 (até 5)
SUBSCRIPTION_PLAN_CODE=solo_monthly
SUBSCRIPTION_PLAN_NAME=Individual
SUBSCRIPTION_AMOUNT_CENTS=3990
SUBSCRIPTION_PLAN_DESCRIPTION=Para quem atende sozinho: agenda, pacientes, prontuário e financeiro.
SUBSCRIPTION_SOLO_PLAN_NAME=Individual
SUBSCRIPTION_SOLO_AMOUNT_CENTS=3990
SUBSCRIPTION_SOLO_PLAN_DESCRIPTION=Para quem atende sozinho: agenda, pacientes, prontuário e financeiro.
SUBSCRIPTION_TEAM_PLAN_NAME=Compartilhado
SUBSCRIPTION_TEAM_AMOUNT_CENTS=6990
SUBSCRIPTION_TEAM_PLAN_DESCRIPTION=Consultório com equipe: até 5 profissionais na mesma clínica.
SUBSCRIPTION_TEAM_MAX_PROFESSIONALS=5
# E-mails que pulam cobrança no /assine (vírgula)
COMPLIMENTARY_SIGNUP_EMAILS=psi.vitoriasousarp@gmail.com,marcosviniciusrdca2@gmail.com
# E-mails com acesso à área /plataforma (métricas SaaS) — e-mail do dono do produto
PLATFORM_ADMIN_EMAILS=marcosviniciusrdca2@gmail.com
# Seed limpo (npm run db:seed) — senhas NÃO vão para o git
SEED_OWNER_EMAIL=psi.vitoriasousarp@gmail.com
SEED_OWNER_NAME=Vitória Sousa
SEED_OWNER_PASSWORD=
SEED_PLATFORM_EMAIL=marcosviniciusrdca2@gmail.com
SEED_PLATFORM_NAME=Marcos Vinicius
SEED_PLATFORM_PASSWORD=
# IA — rascunho de evolução (opcional). Sem chave = gerador local estruturado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
